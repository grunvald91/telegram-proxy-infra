[Unit]
Description=MNEBYDNS Instagram v10 emergency recovery of DNS, nginx and TCP configuration
Documentation=https://github.com/grunvald91/telegram-proxy-infra/pull/79
DefaultDependencies=no
After=local-fs.target
Before=nginx.service mnebydns-dot.service
ConditionPathExists=/var/lib/mneby-iglite-wifi-de-20261111-v10/mutation-ready

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/mneby-iglite-v10/mnebydns_iglite_wifi_multi_meta_v10_w20.py boot-rollback
TimeoutStartSec=120
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
