[Unit]
Description=MNEBYDNS VPN-only local DoT SNI self-route to existing TCP 8854
Documentation=https://github.com/grunvald91/telegram-proxy-infra/pull/194
Wants=network-online.target mneby-awg-tg-relay.service mnebydns-personal-sni-stream.service mnebydns-personal-sni-redirect.service mnebydns-dot.service mnebyvpn-vpn-provisioner.service
After=network-online.target mneby-awg-tg-relay.service mnebydns-personal-sni-stream.service mnebydns-personal-sni-redirect.service mnebydns-dot.service mnebyvpn-vpn-provisioner.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/mnebydns-vpn-dot-selfroute-20261115/manage.sh ensure
ExecStop=/bin/bash /opt/mnebydns-vpn-dot-selfroute-20261115/manage.sh rollback-rule
TimeoutStartSec=50
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
