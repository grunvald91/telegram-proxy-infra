[Unit]
Description=MNEBYDNS DE89 WG-only non-443 protocol relay (mtalk TCP 5228-5230, STUN UDP 19302/3478, NTP UDP 123)
After=network-online.target wg-quick@tg-relay.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=mnebydns-proto-relay
ExecStartPre=/usr/sbin/nginx -t -c /etc/mnebydns/proto-relay/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/mnebydns/proto-relay/nginx.conf -g "daemon off;"
KillSignal=SIGQUIT
TimeoutStartSec=30
TimeoutStopSec=20
Restart=on-failure
RestartSec=2s
MemoryMax=96M
LimitNOFILE=4096
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
