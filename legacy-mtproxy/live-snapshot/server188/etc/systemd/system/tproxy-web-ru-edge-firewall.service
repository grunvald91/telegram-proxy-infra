[Unit]
Description=Allow WEB proxy decoy mirror only from foreign WireGuard peer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -i tg-relay -s <REDACTED> -d 10.66.77.2 -p tcp --dport 3001 -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I INPUT 1 -i tg-relay -s <REDACTED> -d 10.66.77.2 -p tcp --dport 3001 -j ACCEPT'
ExecStop=/bin/sh -c '/usr/sbin/iptables -D INPUT -i tg-relay -s <REDACTED> -d 10.66.77.2 -p tcp --dport 3001 -j ACCEPT 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
