# Every public RF MTProxy link is carried unchanged over WireGuard to the
# foreign SNI router.  This preserves each FakeTLS domain and secret.
server {
    listen 443;
    listen [::]:443;
    proxy_pass 10.66.77.1:443;
    proxy_connect_timeout 5s;
    proxy_timeout 1h;
    proxy_socket_keepalive on;
    tcp_nodelay on;
}
