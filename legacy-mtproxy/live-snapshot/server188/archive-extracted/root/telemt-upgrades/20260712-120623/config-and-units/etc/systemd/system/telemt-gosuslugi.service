[Unit]
Description=Telemt Gosuslugi mask
Wants=network-online.target wg-quick@tg-relay.service
After=network-online.target wg-quick@tg-relay.service

[Service]
Type=simple
User=telemt
Group=telemt
WorkingDirectory=/opt/telemt-gosuslugi
ExecStart=/usr/bin/telemt /etc/telemt/telemt-gosuslugi.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
