#!/bin/sh
set -eu

IPT=/usr/sbin/iptables
SUBNET=37.77.0.0/16
PUBLIC_IP=188.120.254.223
FAST_PORT=10443

remove_rule() {
    table=$1
    shift
    while "$IPT" -t "$table" -D "$@" 2>/dev/null; do :; done
}

remove_all() {
    remove_rule mangle OUTPUT -p tcp -d "$SUBNET" --sport 443 --tcp-flags SYN,RST SYN -m comment --comment codex-temporary-tspu-test -j TCPMSS --set-mss 92
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport 443 --syn -m hashlimit --hashlimit-upto 54/minute --hashlimit-burst 1 --hashlimit-mode srcip --hashlimit-name codex_tspu_allow -m comment --comment codex-temporary-syn-pacing-allow -j ACCEPT
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport 443 --syn -m comment --comment codex-temporary-syn-pacing-reject -j REJECT --reject-with tcp-reset

    remove_rule mangle OUTPUT -p tcp -d "$SUBNET" --sport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-mss -j TCPMSS --set-mss 92
    remove_rule mangle OUTPUT -p tcp -d "$SUBNET" --sport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-mss -j TCPMSS --set-mss 512
    remove_rule mangle OUTPUT -p tcp -d "$SUBNET" --sport "$FAST_PORT" --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-fastpath-mss -j TCPMSS --set-mss 92
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport 443 --tcp-flags SYN,RST SYN -m hashlimit --hashlimit-upto 54/minute --hashlimit-burst 1 --hashlimit-mode srcip --hashlimit-name telegram_tspu_allow -m comment --comment telegram-tspu-syn-allow -j ACCEPT
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport 443 --tcp-flags SYN,RST SYN -m hashlimit --hashlimit-upto 54/minute --hashlimit-burst 6 --hashlimit-mode srcip --hashlimit-name telegram_tspu_allow -m comment --comment telegram-tspu-syn-allow -j ACCEPT
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport 443 --tcp-flags SYN,RST SYN -m hashlimit --hashlimit-upto 54/minute --hashlimit-burst 20 --hashlimit-mode srcip --hashlimit-name telegram_tspu_allow -m comment --comment telegram-tspu-syn-allow -j ACCEPT
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-syn-reject -j REJECT --reject-with tcp-reset
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport "$FAST_PORT" -m comment --comment telegram-tspu-fastpath-allow -j ACCEPT
    remove_rule filter INPUT -p tcp --dport "$FAST_PORT" -m comment --comment telegram-tspu-fastpath-drop -j DROP
    remove_rule nat PREROUTING -s <REDACTED> -d "$PUBLIC_IP" -p tcp --dport 443 -m comment --comment telegram-tspu-fastpath -j REDIRECT --to-ports "$FAST_PORT"
}

case "${1:-apply}" in
    apply)
        remove_all
        "$IPT" -t mangle -I OUTPUT 1 -p tcp -d "$SUBNET" --sport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-mss -j TCPMSS --set-mss 92
        "$IPT" -t mangle -I OUTPUT 1 -p tcp -d "$SUBNET" --sport "$FAST_PORT" --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-fastpath-mss -j TCPMSS --set-mss 92
        "$IPT" -t filter -I INPUT 1 -p tcp --dport "$FAST_PORT" -m comment --comment telegram-tspu-fastpath-drop -j DROP
        "$IPT" -t filter -I INPUT 1 -s <REDACTED> -p tcp --dport "$FAST_PORT" -m comment --comment telegram-tspu-fastpath-allow -j ACCEPT
        "$IPT" -t filter -I INPUT 1 -s <REDACTED> -p tcp --dport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-syn-reject -j REJECT --reject-with tcp-reset
        "$IPT" -t filter -I INPUT 1 -s <REDACTED> -p tcp --dport 443 --tcp-flags SYN,RST SYN -m hashlimit --hashlimit-upto 54/minute --hashlimit-burst 20 --hashlimit-mode srcip --hashlimit-name telegram_tspu_allow -m comment --comment telegram-tspu-syn-allow -j ACCEPT
        "$IPT" -t nat -I PREROUTING 1 -s <REDACTED> -d "$PUBLIC_IP" -p tcp --dport 443 -m comment --comment telegram-tspu-fastpath -j REDIRECT --to-ports "$FAST_PORT"
        ;;
    remove)
        remove_all
        ;;
    *)
        echo "usage: $0 [apply|remove]" >&2
        exit 2
        ;;
esac
