#!/bin/sh
set -eu

IPT=/usr/sbin/iptables
WAN_IF=ens3
SUBNET=37.77.0.0/16
CLIENT_IP=37.77.110.29
PUBLIC_IP=188.120.254.223
FAST_PORT=10443

remove_rule() {
    table=$1
    shift
    while "$IPT" -t "$table" -D "$@" 2>/dev/null; do :; done
}

remove_all() {
    for mss in 92 128 188 256 512; do
        remove_rule mangle OUTPUT -p tcp -d "$SUBNET" --sport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-mss -j TCPMSS --set-mss "$mss"
        remove_rule mangle OUTPUT -p tcp -d "$SUBNET" --sport "$FAST_PORT" --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-fastpath-mss -j TCPMSS --set-mss "$mss"
        remove_rule mangle PREROUTING -i "$WAN_IF" -s <REDACTED> -d "$PUBLIC_IP" -p tcp --dport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-return-mss -j TCPMSS --set-mss "$mss"
    done
    remove_rule mangle PREROUTING -i "$WAN_IF" -s <REDACTED> -d "$PUBLIC_IP" -p tcp --dport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-nfqws-mss-bypass -j RETURN
    remove_rule mangle OUTPUT -p tcp -d "$CLIENT_IP" --sport "$FAST_PORT" --tcp-flags SYN,RST SYN -m comment --comment telegram-nfqws-mss-bypass -j RETURN
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport 443 --tcp-flags SYN,RST SYN -m comment --comment telegram-tspu-syn-reject -j REJECT --reject-with tcp-reset
    remove_rule filter INPUT -s <REDACTED> -p tcp --dport "$FAST_PORT" -m comment --comment telegram-tspu-fastpath-allow -j ACCEPT
    remove_rule filter INPUT -p tcp --dport "$FAST_PORT" -m comment --comment telegram-tspu-fastpath-drop -j DROP
    remove_rule nat PREROUTING -s <REDACTED> -d "$PUBLIC_IP" -p tcp --dport 443 -m comment --comment telegram-tspu-fastpath -j REDIRECT --to-ports "$FAST_PORT"
    while "$IPT" -t filter -S <REDACTED> | grep -q -- '--comment telegram-tspu-syn-allow'; do
        rule=$($IPT -t filter -S <REDACTED> | grep -- '--comment telegram-tspu-syn-allow' | head -n 1 | sed 's/^-A /-D /')
        # shellcheck disable=SC2086
        $IPT -t filter $rule
    done
}

case "${1:-apply}" in
    apply|remove) remove_all ;;
    *) echo "usage: $0 [apply|remove]" >&2; exit 2 ;;
esac
