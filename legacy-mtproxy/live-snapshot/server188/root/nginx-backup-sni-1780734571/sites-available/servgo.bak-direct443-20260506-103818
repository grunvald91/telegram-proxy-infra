server {
    listen 80;
    listen [::]:80;
    server_name servgo.bandbook.site promo.bandbook.site ads.bandbook.site;
    root /var/www/servgo;
    index index.html;
    charset utf-8;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/servgo;
        default_type "text/plain";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 127.0.0.1:4453 ssl http2;
    server_name servgo.bandbook.site promo.bandbook.site ads.bandbook.site;
    root /var/www/servgo;
    index index.html;
    charset utf-8;

    ssl_certificate /etc/letsencrypt/live/servgo.bandbook.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/servgo.bandbook.site/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
