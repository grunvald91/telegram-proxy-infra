{
    admin off
    auto_https off
}

https://proxy.bandbook.site:9442 {
    bind 127.0.0.1
    tls /opt/mtproto-canary/tls/fullchain.pem /opt/mtproto-canary/tls/privkey.pem

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Cache-Control "no-store"
    }

    respond "BandBook secure gateway\n" 200
}
