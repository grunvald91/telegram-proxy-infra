server {
    listen 80;
    listen [::]:80;
    server_name cdn.bandbook.site media.bandbook.site static.bandbook.site assets.bandbook.site;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/proxy-bandbook;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
