#!/bin/sh
set -eu

IPTABLES=/usr/sbin/iptables
SUBNET=37.77.0.0/16
PUBLIC_IP=89.125.90.101
FAST_PORT=9446
MSS=92

add_rule() {
    "$IPTABLES" -t mangle -C OUTPUT -p tcp --sport 443 -d "$SUBNET" \
        --tcp-flags SYN,ACK SYN,ACK -j TCPMSS --set-mss "$MSS" 2>/dev/null || \
    "$IPTABLES" -t mangle -I OUTPUT 1 -p tcp --sport 443 -d "$SUBNET" \
        --tcp-flags SYN,ACK SYN,ACK -j TCPMSS --set-mss "$MSS"

    "$IPTABLES" -t mangle -C OUTPUT -p tcp --sport "$FAST_PORT" -d "$SUBNET" \
        --tcp-flags SYN,ACK SYN,ACK -j TCPMSS --set-mss "$MSS" 2>/dev/null || \
    "$IPTABLES" -t mangle -I OUTPUT 1 -p tcp --sport "$FAST_PORT" -d "$SUBNET" \
        --tcp-flags SYN,ACK SYN,ACK -j TCPMSS --set-mss "$MSS"

    "$IPTABLES" -t nat -C PREROUTING -p tcp -s <REDACTED> -d "$PUBLIC_IP" \
        --dport 443 -j REDIRECT --to-ports "$FAST_PORT" 2>/dev/null || \
    "$IPTABLES" -t nat -I PREROUTING 1 -p tcp -s <REDACTED> -d "$PUBLIC_IP" \
        --dport 443 -j REDIRECT --to-ports "$FAST_PORT"

    "$IPTABLES" -C INPUT -i eth0 -p tcp -s <REDACTED> --dport "$FAST_PORT" \
        -j ACCEPT 2>/dev/null || \
    "$IPTABLES" -I INPUT 1 -i eth0 -p tcp -s <REDACTED> --dport "$FAST_PORT" \
        -j ACCEPT

    "$IPTABLES" -C INPUT -i tg-relay -p tcp -s <REDACTED> --dport "$FAST_PORT" \
        -j ACCEPT 2>/dev/null || \
    "$IPTABLES" -I INPUT 2 -i tg-relay -p tcp -s <REDACTED> --dport "$FAST_PORT" \
        -j ACCEPT

    "$IPTABLES" -C INPUT -i eth0 -p tcp --dport "$FAST_PORT" -j DROP 2>/dev/null || \
    "$IPTABLES" -I INPUT 3 -i eth0 -p tcp --dport "$FAST_PORT" -j DROP
}

remove_rule() {
    while "$IPTABLES" -t mangle -C OUTPUT -p tcp --sport 443 -d "$SUBNET" \
        --tcp-flags SYN,ACK SYN,ACK -j TCPMSS --set-mss "$MSS" 2>/dev/null; do
        "$IPTABLES" -t mangle -D OUTPUT -p tcp --sport 443 -d "$SUBNET" \
            --tcp-flags SYN,ACK SYN,ACK -j TCPMSS --set-mss "$MSS"
    done

    while "$IPTABLES" -t mangle -C OUTPUT -p tcp --sport "$FAST_PORT" -d "$SUBNET" \
        --tcp-flags SYN,ACK SYN,ACK -j TCPMSS --set-mss "$MSS" 2>/dev/null; do
        "$IPTABLES" -t mangle -D OUTPUT -p tcp --sport "$FAST_PORT" -d "$SUBNET" \
            --tcp-flags SYN,ACK SYN,ACK -j TCPMSS --set-mss "$MSS"
    done

    while "$IPTABLES" -t nat -C PREROUTING -p tcp -s <REDACTED> -d "$PUBLIC_IP" \
        --dport 443 -j REDIRECT --to-ports "$FAST_PORT" 2>/dev/null; do
        "$IPTABLES" -t nat -D PREROUTING -p tcp -s <REDACTED> -d "$PUBLIC_IP" \
            --dport 443 -j REDIRECT --to-ports "$FAST_PORT"
    done

    while "$IPTABLES" -C INPUT -i eth0 -p tcp -s <REDACTED> --dport "$FAST_PORT" \
        -j ACCEPT 2>/dev/null; do
        "$IPTABLES" -D INPUT -i eth0 -p tcp -s <REDACTED> --dport "$FAST_PORT" \
            -j ACCEPT
    done

    while "$IPTABLES" -C INPUT -i tg-relay -p tcp -s <REDACTED> --dport "$FAST_PORT" \
        -j ACCEPT 2>/dev/null; do
        "$IPTABLES" -D INPUT -i tg-relay -p tcp -s <REDACTED> --dport "$FAST_PORT" \
            -j ACCEPT
    done

    while "$IPTABLES" -C INPUT -i eth0 -p tcp --dport "$FAST_PORT" -j DROP 2>/dev/null; do
        "$IPTABLES" -D INPUT -i eth0 -p tcp --dport "$FAST_PORT" -j DROP
    done
}

case "${1:-start}" in
    start) add_rule ;;
    stop) remove_rule ;;
    restart) remove_rule; add_rule ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
