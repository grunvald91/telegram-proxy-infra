# Direct MTProxy FakeTLS SNI router. Public 443 is split by TLS SNI.
stream {
    resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

    map $ssl_preread_server_name $direct_mtproxy_backend {
        sberbank.ru 127.0.0.1:9443;
        www.sberbank.ru 127.0.0.1:9443;
        yandex.ru 127.0.0.1:9444;
        www.yandex.ru 127.0.0.1:9444;
        gosuslugi.ru 127.0.0.1:9445;
        www.gosuslugi.ru 127.0.0.1:9445;
        cdn.servgo.ru 127.0.0.1:4453;
        tg.servgo.ru 127.0.0.1:5443;
        tg.eunoia.fun 127.0.0.1:5444;
        www.google.com 127.0.0.1:8443;
        xapi.ozon.ru 127.0.0.1:9446;
        m.ozon.ru 127.0.0.1:9447;
        www.avito.ru 127.0.0.1:9450;
        www.kinopoisk.ru 127.0.0.1:9449;
        cloud.mail.ru 127.0.0.1:9448;
        disk.yandex.ru 127.0.0.1:9451;
        api.ozon.ru 127.0.0.1:9446;
        www.ozon.ru 127.0.0.1:9446;
        ozon.ru 127.0.0.1:9446;
        default 127.0.0.1:9443;
    }

    server {
        listen 443;
        listen [::]:443;
        proxy_pass $direct_mtproxy_backend;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
        proxy_socket_keepalive on;
        tcp_nodelay on;
        ssl_preread on;
    }
}
