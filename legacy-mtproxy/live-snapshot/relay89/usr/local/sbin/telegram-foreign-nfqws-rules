#!/bin/sh
set -eu

WAN_IF=eth0
QUEUE=210

remove_all() {
    nft delete table inet telegram_nfqws 2>/dev/null || true
}

case "${1:-apply}" in
    apply)
        remove_all
        nft add table inet telegram_nfqws
        nft 'add chain inet telegram_nfqws post { type filter hook postrouting priority 101; policy accept; }'
        nft add rule inet telegram_nfqws post oifname "$WAN_IF" tcp sport 443 ct reply packets 1-20 meta mark and 0x40000000 == 0 counter queue num "$QUEUE" bypass comment telegram-nfqws
        nft 'add chain inet telegram_nfqws predefrag { type filter hook output priority -401; policy accept; }'
        nft add rule inet telegram_nfqws predefrag meta mark and 0x40000000 != 0 notrack
        ;;
    remove) remove_all ;;
    *) echo "usage: $0 [apply|remove]" >&2; exit 2 ;;
esac
