[Unit]
Description=Telemt RF ingress with real media.bandbook.site mask
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telemt
Group=telemt
WorkingDirectory=/opt/telemt-rf-media
ExecStart=/usr/bin/telemt --silent /etc/telemt/rf-media.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
