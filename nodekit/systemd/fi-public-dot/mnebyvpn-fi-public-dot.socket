[Unit]
Description=MNEBYVPN FI public personal DoT socket
After=network-online.target mnebyvpn-fi-dns-country.service mnebyvpn-fi-sni-routed-v3.service mnebyvpn-fi-sni-egress-guard.service
Wants=network-online.target
BindsTo=mnebyvpn-fi-dns-country.service mnebyvpn-fi-sni-routed-v3.service mnebyvpn-fi-sni-egress-guard.service
ConditionPathExists=/var/lib/mnebyvpn-nodekit/fi-test-01/dns-auth/public-dot.enable

[Socket]
ListenStream=217.11.167.91:853
Accept=no
Backlog=64
Service=mnebyvpn-fi-public-dot.service

[Install]
WantedBy=sockets.target
