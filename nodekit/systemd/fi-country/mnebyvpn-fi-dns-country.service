[Unit]
Description=MNEBYVPN FI country-zone routed CoreDNS and metered DoT
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
Conflicts=mnebyvpn-fi-dns-private.service mnebyvpn-fi-dns-routed.service
ConditionPathExists=/var/lib/mnebyvpn-nodekit/fi-test-01/dns-auth/country-dataplane.enable

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/opt/mnebyvpn-fi-dns-country-v2
ExecStart=/usr/bin/python3 /opt/mnebyvpn-fi-dns-country-v2/fi_routed_runtime.py
Restart=on-failure
RestartSec=10s
TimeoutStopSec=12s
KillMode=control-group
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mnebyvpn-nodekit/fi-test-01/dns-auth
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=1.1.1.1/32
IPAddressAllow=1.0.0.1/32
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
TasksMax=64
MemoryMax=192M

[Install]
WantedBy=multi-user.target
